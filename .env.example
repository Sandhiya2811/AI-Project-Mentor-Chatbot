# Copy this file to ".env" (PowerShell:  Copy-Item .env.example .env) and edit it.
# Everything here can also be changed later in the app: Settings screen.
# Do NOT put real API keys in .env.example - only in your private ".env".

# ---- AI model (cloud providers are the default; nothing is downloaded to your computer) -------------------------
# openai | anthropic | google | perplexity | zai | ollama (optional, local - only used if you select it) | openai_compatible
LLM_PROVIDER=openai
# Leave empty to use the provider's default model. Examples: gpt-4o-mini | claude-sonnet-5-5 | gemini-2.5-flash |
# sonar | glm-4.5-air | llama3.2:3b (Ollama).  You can also pick the model in Settings (it lists the models per provider).
LLM_MODEL=
# Leave empty for the provider's default address (only change it for a proxy or a custom server)
# LLM_BASE_URL=
# API KEYS: the safest place is the Settings screen (stored in Windows Credential Manager when the 'keyring' package is
# installed). If you prefer environment variables, put them in your PRIVATE ".env" (never in this example file, never in Git):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# ZAI_API_KEY=
LLM_TEMPERATURE=0.4
# Seconds to wait for a reply. Empty = provider default (cloud 60, Ollama 180)
LLM_TIMEOUT=

# ---- Speed ------------------------------------------------------------------------------------------------
# Ollama only: context window in tokens. Keep it constant (changing it makes Ollama reload the model).
LLM_NUM_CTX=4096
# Ollama only: how long the model stays in memory after the last request
LLM_KEEP_ALIVE=30m
# Upper limit for a normal chat answer (the full-roadmap overview is allowed more). Lower = faster.
CHAT_MAX_TOKENS=900
# idle = write AI learning notes in the background only while you are not chatting | off
AUTO_AI_NOTES=idle

# ---- Knowledge base (RAG) -----------------------------------------------------------------------------------
# hash (offline, no download) | sentence-transformers | ollama
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL=

# ---- Application ------------------------------------------------------------------------------------------
# dark | light | system
THEME=dark
# auto = run a student's Python tests only when the OS can isolate the network (not available on Windows) | off
CODE_EXECUTION=auto
# Move database / uploads / index to another folder (optional)
# MENTOR_STORAGE_DIR=
