# Copy this file to ".env" (PowerShell:  Copy-Item .env.example .env) and edit it.
# Everything here can also be changed later in the app: Settings screen.
# Do NOT put real API keys in .env.example - only in your private ".env".

# ---- AI model ---------------------------------------------------------------------------------------------
# ollama | openai | anthropic | openai_compatible
LLM_PROVIDER=ollama
# Ollama example: llama3.2:3b (fast) or llama3.1:8b (better quality, slower). Must match `ollama list`.
LLM_MODEL=llama3.2:3b
# Leave empty for the provider default (Ollama: http://localhost:11434)
# LLM_BASE_URL=
# Only for openai / anthropic / openai_compatible (or use OPENAI_API_KEY / ANTHROPIC_API_KEY)
# LLM_API_KEY=
LLM_TEMPERATURE=0.4
# Seconds to wait for the model (first answer after a cold start can be slow on CPU)
LLM_TIMEOUT=180

# ---- Speed ------------------------------------------------------------------------------------------------
# Ollama context window in tokens. Keep it constant (changing it makes Ollama reload the model).
LLM_NUM_CTX=4096
# Ollama: how long the model stays in memory after the last request
LLM_KEEP_ALIVE=30m
# Upper limit for a normal chat answer (the full-roadmap overview is allowed more). Lower = faster.
CHAT_MAX_TOKENS=900
# idle = write AI learning notes in the background only while you are not chatting | off
AUTO_AI_NOTES=idle

# ---- Knowledge base (RAG) -----------------------------------------------------------------------------------
# hash (offline, no download) | sentence-transformers | ollama
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL=

# ---- Application ------------------------------------------------------------------------------------------
# dark | light | system
THEME=dark
# auto = run a student's Python tests only when the OS can isolate the network (not available on Windows) | off
CODE_EXECUTION=auto
# Move database / uploads / index to another folder (optional)
# MENTOR_STORAGE_DIR=
