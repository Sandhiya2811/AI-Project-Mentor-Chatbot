# Copy to .env and edit. Everything can also be changed later in Settings.
# Provider: ollama | openai | anthropic | openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=            (or OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=180

# RAG embeddings: hash (offline, no download) | sentence-transformers | ollama
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

THEME=dark                # dark | light | system
CODE_EXECUTION=auto       # auto = run student tests only when network isolation exists | off
# MENTOR_STORAGE_DIR=     # relocate database/uploads/index
